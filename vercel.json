{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "conicboulevard.info" }
      ],
      "destination": "https://www.conicboulevard.info/$1",
      "permanent": true
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
