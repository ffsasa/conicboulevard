{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "conicboulevard.pro.vn"
        }
      ],
      "destination": "https://www.conicboulevard.pro.vn/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "conicboulevard.vercel.app"
        }
      ],
      "destination": "https://www.conicboulevard.pro.vn/$1",
      "permanent": true
    }
  ]
}
